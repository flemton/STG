{
  "expo": {
    "name": "STG Triage",
    "slug": "stg-triage",
    "version": "1.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f2efe8"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flemton.stgtriage",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f2efe8"
      },
      "package": "com.flemton.stgtriage"
    },
    "extra": {
      "eas": {
        "projectId": "0fe9373c-17c3-4d60-9734-38e2f8726a7f"
      }
    }
  }
}
